===================================================== */

function highlightBFS(order) {

    clearHighlights();


    order.forEach(id => {

        let node =
            document.querySelector(
                `.graph-node[data-id="${id}"]`
            );


        if (node) {

            node.classList.add("bfs-node");

        }

    });
}


/* =====================================================
   HIGHLIGHT DFS
===================================================== */

function highlightDFS(order) {

    clearHighlights();


    order.forEach(id => {

        let node =
            document.querySelector(
                `.graph-node[data-id="${id}"]`
            );


        if (node) {

            node.classList.add("dfs-node");

        }

    });
}


/* =====================================================
   HIGHLIGHT CYCLE
===================================================== */

function highlightCycle() {

    clearHighlights();


    document
        .querySelectorAll(".graph-node")
        .forEach(node => {

            node.classList.add("cycle-node");

        });
}


/* =====================================================
   CLEAR HIGHLIGHTS
===================================================== */

function clearHighlights() {

    document
        .querySelectorAll(".graph-node")
        .forEach(node => {

            node.classList.remove(
                "bfs-node",
                "dfs-node",
                "cycle-node"
            );

        });
}


