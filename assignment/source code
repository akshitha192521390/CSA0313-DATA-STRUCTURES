 #include <stdio.h>
#include <stdlib.h>

#define MAX 100

int graph[MAX][MAX];
int visited[MAX];
int recursionStack[MAX];
int indegree[MAX];

int n;

/* Add an edge:
   prerequisite -> dependent course
*/
void addEdge(int from, int to)
{
    graph[from][to] = 1;
}

/* --------------------------------------------------
   DFS Cycle Detection
-------------------------------------------------- */

int dfsCycle(int node)
{
    visited[node] = 1;
    recursionStack[node] = 1;

    for (int i = 0; i < n; i++)
    {
        if (graph[node][i])
        {
            /* Back edge means cycle */
            if (!visited[i])
            {
                if (dfsCycle(i))
                    return 1;
            }
            else if (recursionStack[i])
            {
                return 1;
            }
        }
    }

    recursionStack[node] = 0;

    return 0;
}

int detectCycleDFS()
{
    for (int i = 0; i < n; i++)
    {
        visited[i] = 0;
        recursionStack[i] = 0;
    }

    for (int i = 0; i < n; i++)
    {
        if (!visited[i])
        {
            if (dfsCycle(i))
                return 1;
        }
    }

    return 0;
}

/* --------------------------------------------------
   BFS / Kahn's Algorithm
-------------------------------------------------- */

void topologicalSortBFS()
{
    int queue[MAX];
    int front = 0;
    int rear = 0;
    int count = 0;

    /* Calculate indegree */
    for (int i = 0; i < n; i++)
        indegree[i] = 0;

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            if (graph[i][j])
                indegree[j]++;
        }
    }

    /* Add zero-indegree vertices */
    for (int i = 0; i < n; i++)
    {
        if (indegree[i] == 0)
            queue[rear++] = i;
    }

    printf("\nBFS / Kahn's Topological Order:\n");

    while (front < rear)
    {
        int current = queue[front++];

        printf("%d ", current);

        count++;

        for (int i = 0; i < n; i++)
        {
            if (graph[current][i])
            {
                indegree[i]--;

                if (indegree[i] == 0)
                    queue[rear++] = i;
            }
        }
    }

    printf("\n");

    if (count != n)
    {
        printf("Cycle Detected!\n");
        printf("Topological sorting is not possible.\n");
    }
    else
    {
        printf("No Cycle Detected.\n");
    }
}

/* --------------------------------------------------
   DFS Topological Sort
-------------------------------------------------- */

void dfsTopological(int node, int stack[], int *top)
{
    visited[node] = 1;

    for (int i = 0; i < n; i++)
    {
        if (graph[node][i] && !visited[i])
        {
            dfsTopological(i, stack, top);
        }
    }

    stack[(*top)++] = node;
}

void topologicalSortDFS()
{
    int stack[MAX];
    int top = 0;

    for (int i = 0; i < n; i++)
        visited[i] = 0;

    if (detectCycleDFS())
    {
        printf("\nDFS Result:\n");
        printf("Cycle Detected!\n");
        printf("Topological sorting is not possible.\n");
        return;
    }

    for (int i = 0; i < n; i++)
    {
        if (!visited[i])
        {
            dfsTopological(i, stack, &top);
        }
    }

    printf("\nDFS Topological Order:\n");

    for (int i = top - 1; i >= 0; i--)
    {
        printf("%d ", stack[i]);
    }

    printf("\n");
    printf("No Cycle Detected.\n");
}

/* --------------------------------------------------
   Main Function
-------------------------------------------------- */

int main()
{
    int edges;
    int from, to;

    printf("COURSE PREREQUISITE MANAGEMENT SYSTEM\n");
    printf("======================================\n");

    printf("\nEnter number of courses: ");
    scanf("%d", &n);

    /* Initialize graph */
    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            graph[i][j] = 0;
        }
    }

    printf("\nEnter number of prerequisite relationships: ");
    scanf("%d", &edges);

    printf("\nEnter relationships:\n");
    printf("Example: 0 1 means Course 0 -> Course 1\n\n");

    for (int i = 0; i < edges; i++)
    {
        printf("Relationship %d: ", i + 1);

        scanf("%d %d", &from, &to);

        addEdge(from, to);
    }

    /* Run BFS / Kahn's Algorithm */
    topologicalSortBFS();

    /* Run DFS */
    topologicalSortDFS();

    return 0;
}
