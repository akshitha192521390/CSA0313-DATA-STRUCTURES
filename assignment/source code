<script>

/* =====================================================
   DATA
===================================================== */

let courses = [];

let prerequisites = [];


/* =====================================================
   ADD COURSE
===================================================== */

function addCourse() {

    let id =
        document.getElementById("courseId").value.trim();

    let name =
        document.getElementById("courseName").value.trim();


    if (id === "" || name === "") {

        alert("Please enter Course ID and Course Name.");

        return;
    }


    if (courses.some(c => c.id === id)) {

        alert("Course ID already exists.");

        return;
    }


    courses.push({
        id: id,
        name: name
    });


    document.getElementById("courseId").value = "";

    document.getElementById("courseName").value = "";


    displayCourses();

    updateDashboard();

    displayGraph();
}


/* =====================================================
   DISPLAY COURSES
===================================================== */

function displayCourses() {

    let table =
        document.getElementById("courseTable");


    table.innerHTML = "";


    courses.forEach(course => {

        let row =
            document.createElement("tr");


        row.innerHTML = `
            <td><strong>${course.id}</strong></td>
            <td>${course.name}</td>
        `;


        table.appendChild(row);

    });
}


/* =====================================================
   ADD PREREQUISITE
===================================================== */

function addPrerequisite() {

    let from =
        document.getElementById("prerequisite").value.trim();

    let to =
        document.getElementById("dependent").value.trim();


    if (from === "" || to === "") {

        alert("Please enter both Course IDs.");

        return;
    }


    if (from === to) {

        alert("A course cannot depend on itself.");

        return;
    }


    if (!courses.some(c => c.id === from)) {

        alert("Prerequisite course does not exist.");

        return;
    }


    if (!courses.some(c => c.id === to)) {

        alert("Dependent course does not exist.");

        return;
    }


    if (
        prerequisites.some(
            e => e.from === from && e.to === to
        )
    ) {

        alert("Relationship already exists.");

        return;
    }


    prerequisites.push({
        from: from,
        to: to
    });


    document.getElementById("prerequisite").value = "";

    document.getElementById("dependent").value = "";


    displayGraph();

    updateDashboard();
}


/* =====================================================
   CREATE GRAPH
===================================================== */

function createGraph() {

    let graph = {};


    courses.forEach(course => {

        graph[course.id] = [];

    });


    prerequisites.forEach(edge => {

        graph[edge.from].push(edge.to);

    });


    return graph;
}


/* =====================================================
   UPDATE DASHBOARD
===================================================== */

function updateDashboard() {

    document.getElementById("totalCourses").innerText =
        courses.length;


    document.getElementById("totalPrerequisites").innerText =
        prerequisites.length;
}


/* =====================================================
   DISPLAY GRAPH
===================================================== */

function displayGraph() {

    let svg =
        document.getElementById("graphSvg");


    let text =
        document.getElementById("relationshipText");


    svg.innerHTML = `

        <defs>

            <marker
                id="arrow"
                markerWidth="10"
                markerHeight="10"
                refX="9"
                refY="3"
                orient="auto">

                <path
                    d="M0,0 L0,6 L9,3 z"
                    fill="#475569">
                </path>

            </marker>

        </defs>

    `;


    if (courses.length === 0) {

        svg.innerHTML += `
            <text
                x="500"
                y="200"
                text-anchor="middle"
                font-size="22"
                fill="#64748b">

                Add courses to display the graph

            </text>
        `;

        text.innerText =
            "No courses available.";

        return;
    }


    let positions = {};

    let count = courses.length;


    let spacing =
        count === 1 ? 0 : 850 / (count - 1);


    courses.forEach((course, index) => {

        positions[course.id] = {

            x:
                count === 1
                ? 500
                : 75 + index * spacing,

            y: 190

        };

    });


    /* Draw arrows */

    prerequisites.forEach(edge => {

        let from =
            positions[edge.from];

        let to =
            positions[edge.to];


        let line =
            document.createElementNS(
                "http://www.w3.org/2000/svg",
                "line"
            );


        let x1 = from.x;

        let x2 = to.x;


        if (x2 >= x1) {

            x1 += 45;

            x2 -= 45;

        } else {

            x1 -= 45;

            x2 += 45;

        }


        line.setAttribute("x1", x1);

        line.setAttribute("y1", from.y);

        line.setAttribute("x2", x2);

        line.setAttribute("y2", to.y);

        line.setAttribute(
            "class",
            "graph-arrow"
        );


        svg.appendChild(line);

    });


    /* Draw nodes */

    courses.forEach(course => {

        let position =
            positions[course.id];


        let circle =
            document.createElementNS(
                "http://www.w3.org/2000/svg",
                "circle"
            );


        circle.setAttribute(
            "cx",
            position.x
        );

        circle.setAttribute(
            "cy",
            position.y
        );

        circle.setAttribute(
            "r",
            "45"
        );

        circle.setAttribute(
            "class",
            "graph-node"
        );

        circle.setAttribute(
            "data-id",
            course.id
        );


        svg.appendChild(circle);


        let idText =
            document.createElementNS(
                "http://www.w3.org/2000/svg",
                "text"
            );


        idText.setAttribute(
            "x",
            position.x
        );

        idText.setAttribute(
            "y",
            position.y
        );

        idText.setAttribute(
            "class",
            "graph-node-text"
        );

        idText.textContent =
            course.id;


        svg.appendChild(idText);


        let nameText =
            document.createElementNS(
                "http://www.w3.org/2000/svg",
                "text"
            );


        nameText.setAttribute(
            "x",
            position.x
        );

        nameText.setAttribute(
            "y",
            position.y + 70
        );

        nameText.setAttribute(
            "class",
            "graph-course-name"
        );


        let name = course.name;

        if (name.length > 20) {

            name =
                name.substring(0, 20) + "...";

        }


        nameText.textContent = name;


        svg.appendChild(nameText);

    });


    if (prerequisites.length === 0) {

        text.innerHTML =
            "No prerequisite relationships yet.";

    } else {

        text.innerHTML =
            "<strong>Relationships:</strong><br><br>" +

            prerequisites.map(
                e =>
                    `<span class="order-item">
                        ${e.from} → ${e.to}
                    </span>`
            ).join("");

    }
}


/* =====================================================
   BFS / KAHN
===================================================== */

function runBFS() {

    if (courses.length === 0) {

        alert("Please add courses first.");

        return;
    }


    let graph = createGraph();

    let indegree = {};


    courses.forEach(course => {

        indegree[course.id] = 0;

    });


    prerequisites.forEach(edge => {

        indegree[edge.to]++;

    });


    let queue = [];


    courses.forEach(course => {

        if (indegree[course.id] === 0) {

            queue.push(course.id);

        }

    });


    let order = [];


    while (queue.length > 0) {

        let current =
            queue.shift();


        order.push(current);


        graph[current].forEach(next => {

            indegree[next]--;


            if (indegree[next] === 0) {

                queue.push(next);

            }

        });

    }


    let result =
        document.getElementById("bfsResult");


    if (order.length !== courses.length) {

        result.innerHTML = `
            <span class="cycle">
                ⚠ Cycle Detected!<br>
                Topological sorting is not possible.
            </span>
        `;


        document.getElementById("cycleStatus").innerHTML =
            `<span class="cycle">Cycle Detected</span>`;


        highlightCycle();

        return;
    }


    let html =
        `<span class="no-cycle">
            ✓ No Cycle Detected
        </span>
        <br><br>
        <strong>Topological Order:</strong><br>`;


    order.forEach((id, index) => {

        html +=
            `<span class="order-item">${id}</span>`;


        if (index < order.length - 1) {

            html += " → ";

        }

    });


    result.innerHTML = html;


    document.getElementById("cycleStatus").innerHTML =
        `<span class="no-cycle">No Cycle</span>`;


    highlightBFS(order);
}


/* =====================================================
   DFS CYCLE DETECTION
===================================================== */

function runDFS() {

    if (courses.length === 0) {

        alert("Please add courses first.");

        return;
    }


    let graph = createGraph();

    let state = {};

    let stack = [];

    let cycle = false;


    courses.forEach(course => {

        state[course.id] = 0;

    });


    function dfs(node) {

        state[node] = 1;


        for (let next of graph[node]) {

            if (state[next] === 1) {

                cycle = true;

                return;
            }


            if (state[next] === 0) {

                dfs(next);

                if (cycle)
                    return;
            }
        }


        state[node] = 2;

        stack.push(node);
    }


    for (let course of courses) {

        if (state[course.id] === 0) {

            dfs(course.id);

            if (cycle)
                break;
        }
    }


    let result =
        document.getElementById("dfsResult");


    if (cycle) {

        result.innerHTML = `
            <span class="cycle">
                ⚠ Cycle Detected!<br>
                Topological sorting is not possible.
            </span>
        `;


        document.getElementById("cycleStatus").innerHTML =
            `<span class="cycle">Cycle Detected</span>`;


        highlightCycle();

        return;
    }


    stack.reverse();


    let html =
        `<span class="no-cycle">
            ✓ No Cycle Detected
        </span>
        <br><br>
        <strong>Topological Order:</strong><br>`;


    stack.forEach((id, index) => {

        html +=
            `<span class="order-item">${id}</span>`;


        if (index < stack.length - 1) {

            html += " → ";

        }

    });


    result.innerHTML = html;


    document.getElementById("cycleStatus").innerHTML =
        `<span class="no-cycle">No Cycle</span>`;


    highlightDFS(stack);
}


